# syntax=docker/dockerfile:1.7
#
# qwen3-tts.cpp — Vulkan build.
#
# Build:
#   docker build -f Dockerfile.vulkan -t qwen3-tts:vulkan .
#
# Run (AMD/Intel/Nvidia GPU via the host's mesa/RADV stack):
#   docker run --rm -it \
#     --device /dev/dri --group-add video \
#     -p 8081:8081 \
#     -v /path/to/models:/models:ro \
#     -v /path/to/voices:/voices:ro \
#     -e TTS_MODEL=/models/Qwen3-TTS-12Hz-1.7B-Base-Q8_0.gguf \
#     -e TTS_VOCODER=/models/Qwen3-TTS-Tokenizer-12Hz-F16.gguf \
#     -e TTS_VOICES_DIR=/voices \
#     -e TZ=Europe/Warsaw \
#     qwen3-tts:vulkan
#
# TZ defaults to UTC inside the container; set -e TZ=<IANA name> (e.g.
# Europe/Warsaw, America/New_York) so the server's log timestamps match
# wall-clock time on the host.
#
# Note: the build is portable by default (plain -O3; ggml's CPU backend still
# assumes AVX2, so "portable" means any modern x86-64). To tune the image to the
# CPU that runs `docker build` — worth a few percent, and only correct when the
# build host and the run host are the same machine:
#
#   docker build -f Dockerfile.vulkan --build-arg QWEN3_TTS_NATIVE=ON -t qwen3-tts:vulkan .
#
# A native image moved to a different CPU dies with SIGILL and no useful error.

# ---------- builder ----------
FROM debian:trixie-slim AS builder

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        git \
        pkg-config \
        ca-certificates \
        libmpg123-dev \
        libopusenc-dev \
        libmp3lame-dev \
        libopus-dev \
        libvulkan-dev \
        glslc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

ARG QWEN3_TTS_NATIVE=OFF
RUN cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DQWEN3_TTS_NATIVE=${QWEN3_TTS_NATIVE} \
        -DGGML_VULKAN=ON \
        -DCMAKE_INSTALL_PREFIX=/opt/qwen3-tts \
    && cmake --build build -j \
    && cmake --install build

# ---------- runtime ----------
FROM debian:trixie-slim AS runtime

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libmpg123-0 \
        libopusenc0 \
        libmp3lame0 \
        libopus0 \
        libvulkan1 \
        mesa-vulkan-drivers \
        libegl1 \
        libxext6 \
        libgomp1 \
        tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/qwen3-tts /opt/qwen3-tts

# GGML_VK_DISABLE_MULTI_ADD: ggml's multi-add fusion is pathological on RADV
# (RX 6800 XT: RTF 2.20 with it, 0.65 without — the vocoder sums 15 residual
# projections over very large tensors). Neutral on other Vulkan drivers, so it
# is safe to set unconditionally here. See docs/known-issues.md #8.
ENV PATH=/opt/qwen3-tts/bin:$PATH \
    LD_LIBRARY_PATH=/opt/qwen3-tts/lib \
    GGML_VK_DISABLE_MULTI_ADD=1 \
    TTS_HOST=0.0.0.0 \
    TTS_PORT=8081 \
    TTS_THREADS=8

EXPOSE 8081
ENTRYPOINT ["/opt/qwen3-tts/bin/qwen3-tts-server"]
